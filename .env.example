# Public origin of the site (used for canonical/hreflang/sitemap at build time).
SITE_URL=https://example.ru

# Admin panel password (at least 12 characters in production).
ADMIN_PASSWORD=change-me-to-a-long-password

# Secret for signing admin sessions (at least 32 characters): openssl rand -hex 32
SESSION_SECRET=

# Salt for hashing visitor IPs (any random string): openssl rand -hex 16
IP_HASH_SALT=

# Set to true when the site is served over HTTPS.
COOKIE_SECURE=true

# Optional: SQLite file location (default ./data/leads.db).
# DATABASE_PATH=./data/leads.db

# Optional: lead submissions allowed per IP per 10 minutes (default 5).
# LEAD_RATE_LIMIT=5
